    "requires_residual_risk_and_remediation": true
  },
  "pass_requires": [
    "all_hard_gates_pass",
    "all_critical_quality_gates_pass",
    "all_regression_gates_pass",
    "mandatory_dependency_fault_safety_pass",
    "mandatory_recovery_pass",
    "applicable_local_operational_gates_pass",
    "no_conditional_eligible_breach",
    "reproducible_sanitized_evidence_package"
  ]
