{"fragments":[{"path":["reference"],"value":"#/components/schemas/simple-repository"},{"path":["value","description"],"value":"A GitHub repository."},{"path":["value","properties","archive_url"],"value":{"description":"A template for the API URL to download the repository as an archive.","example":"https://api.github.com/repos/octocat/Hello-World/{archive_format}{/ref}","type":"string"}},{"path":["value","properties","assignees_url"],"value":{"description":"A template for the API URL to list the available assignees for issues in the repository.","example":"https://api.github.com/repos/octocat/Hello-World/assignees{/user}","type":"string"}},{"path":["value","properties","blobs_url"],"value":{"description":"A template for the API URL to create or retrieve a raw Git blob in the repository.","example":"https://api.github.com/repos/octocat/Hello-World/git/blobs{/sha}","type":"string"}},{"path":["value","properties","branches_url"],"value":{"description":"A template for the API URL to get information about branches in the repository.","example":"https://api.github.com/repos/octocat/Hello-World/branches{/branch}","type":"string"}},{"path":["value","properties","collaborators_url"],"value":{"description":"A template for the API URL to get information about collaborators of the repository.","example":"https://api.github.com/repos/octocat/Hello-World/collaborators{/collaborator}","type":"string"}},{"path":["value","properties","comments_url"],"value":{"description":"A template for the API URL to get information about comments on the repository.","example":"https://api.github.com/repos/octocat/Hello-World/comments{/number}","type":"string"}},{"path":["value","properties","commits_url"],"value":{"description":"A template for the API URL to get information about commits on the repository.","example":"https://api.github.com/repos/octocat/Hello-World/commits{/sha}","type":"string"}},{"path":["value","properties","compare_url"],"value":{"description":"A template for the API URL to 