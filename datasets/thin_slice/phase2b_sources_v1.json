    {
      "manifest": {
        "source_id": "thin-src-api-versions",
        "source_family": "github_rest_authored_guidance",
        "source_url": "https://github.com/github/docs/blob/ec3629a841129ae28189d7bb2274a7b3d40c5095/content/rest/about-the-rest-api/api-versions.md",
